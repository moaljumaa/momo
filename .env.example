# Local dev only. Deployed envs use Infisical (see global setup).
DATABASE_URL=postgresql://momobot:momobot@postgres:5432/momobot
REDIS_URL=redis://redis:6379

# Encrypts secrets stored in the database (falls back to BETTER_AUTH_SECRET). Back it up; losing it makes stored keys unreadable.
ENCRYPTION_KEY=

# Website crawler and private addresses (localhost, 10.x, 192.168.x). Default: allowed in dev, blocked in production.
# ALLOW_PRIVATE_URLS=true
