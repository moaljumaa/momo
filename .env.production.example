# Copy to .env.production and fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Encrypts stored API keys. Back it up: losing it makes stored keys unreadable.
ENCRYPTION_KEY=
# The public URL people use to reach the app (must match exactly, including https://).
BETTER_AUTH_URL=http://localhost:3000
WEB_PORT=3000
# Optional. You can also enter the OpenRouter key in the onboarding instead.
OPENROUTER_API_KEY=
# ALLOW_PRIVATE_URLS=true   # let the crawler reach localhost/intranet (blocked by default in production)
# GEOIP_LOOKUP=true         # look up visitor country via ip-api.com (off by default)
